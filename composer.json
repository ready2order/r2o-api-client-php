{
    "name": "ready2order/r2o-api-client-php",
    "description": "PHP library for ready2order POS API v1",
    "keywords": ["ready2order", "api", "client", "pos", "guzzle"],
    "replace": {
        "duxthefux/ready2order-php-api-v1" : "1.*"
    },
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.16 || ^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^7.4",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "ready2order\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ready2order\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix",
        "lint:check": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --testsuite unit",
        "test:api": "phpunit --testsuite api"
    },
    "homepage": "https://github.com/ready2order/r2o-api-client-php",
    "authors": [
        {
            "name": "ready2order GmbH",
            "email": "operations@ready2order.com",
            "homepage": "http://www.ready2order.com"
        }
    ]

}
